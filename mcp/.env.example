# Copy to .env (git-ignored) for local use, or set these in the Render dashboard. Never commit real values.

# Required. The root secret: protects the OAuth consent page and the owner API. The relay refuses to start unless it is
# >= 32 chars with about 128 bits of randomness, so generate it (do not invent one): npm run gen-secret
DAYCUE_OWNER_SECRET=

# Trusted reverse-proxy hops in front of the relay (X-Forwarded-For entries counted from the right). Default: 1 on Render, 0 elsewhere.
# Per-source throttling uses this address; getting it wrong either merges all callers into one bucket or lets them spoof their address.
# DAYCUE_TRUSTED_PROXY_HOPS=1

# Comma-separated HTTPS hosts shown as official callback hosts on the consent page (loopback is always recognized).
# Default: claude.ai,claude.com,chatgpt.com. Anything else gets a red warning and needs an extra tick.
# DAYCUE_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com

# Default true: write-capable scopes (config:write, sessions:control, medication) of a NEW grant stay inactive until the phone approves it.
# DAYCUE_REQUIRE_PHONE_APPROVAL=true

# Public origin of the relay, no trailing slash. On Render it defaults to RENDER_EXTERNAL_URL.
DAYCUE_BASE_URL=http://localhost:8787
PORT=8787

# Storage (first one set wins): DATABASE_URL (Postgres) > DAYCUE_DATA_FILE (JSON file on a persistent disk) > .data/relay.json
DATABASE_URL=
# Postgres TLS is verified by default. DATABASE_SSL=false for a private-network URL; DATABASE_SSL=insecure skips certificate verification (not recommended).
# DATABASE_SSL=
DAYCUE_DATA_FILE=

# Optional: Firebase service-account JSON (single line) to send FCM "wake and sync" pushes.
FCM_SERVICE_ACCOUNT_JSON=

# --- stdio server (Claude Code) ---
DAYCUE_RELAY_URL=http://localhost:8787
DAYCUE_CLIENT_TOKEN=
