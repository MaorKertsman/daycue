<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Debug-only component gallery. Launch from adb:
         adb shell am start -n app.daycue/app.daycue.debug.GalleryActivity -e page today
         String extras (use -e): page = today|marks|field|controls|rows|pickers|overlays|states, chrome = false hides the page
         tabs, sheet = true / dialog = true open the live overlay, reduce_motion = true. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        tools:ignore="MissingApplicationIcon">

        <activity
            android:name="app.daycue.debug.GalleryActivity"
            android:exported="true"
            android:label="@string/gallery_app_label"
            android:theme="@style/Theme.DayCue">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="app.daycue.debug.setup.SetupDebugActivity"
            android:exported="true"
            android:label="DayCue Setup (debug)"
            android:theme="@style/Theme.DayCue" />
        <activity
            android:name="app.daycue.debug.cues.CuesDebugActivity"
            android:exported="true"
            android:label="DayCue Cues (debug)"
            android:theme="@style/Theme.DayCue" />

        <!-- Debug-only engine driver (VALIDATION D2: absent from release). Callable only by holders of DUMP
             (adb shell). See src/debug/kotlin/app/daycue/devtools/DevToolsReceiver.kt. -->
        <receiver
            android:name="app.daycue.devtools.DevToolsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="app.daycue.devtools.CMD" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
