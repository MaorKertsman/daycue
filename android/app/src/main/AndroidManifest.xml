<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Install-time permissions (docs/architecture/ANDROID.md §5.2, §8). Runtime permissions are
         asked in context by the UI; nothing is requested at first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Context producers (integrations/location, integrations/calendar). All runtime permissions,
         requested progressively in context by the UI (fine -> background as separate steps). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" android:maxSdkVersion="28" />
    <!-- Read only: DayCue never writes to the calendar (docs/adr/0004-calendar-provider.md). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Speech: TextToSpeech engines are found via this intent on API 30+ (package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Spotify alarm source: detect whether the Spotify app is installed (integrations/spotify). -->
        <package android:name="com.spotify.music" />
    </queries>

    <!-- The confirmation screen asks the system to hide overlay windows while it is shown (API 31+, normal permission). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!-- Relay (remote access): network only; no permission beyond INTERNET is needed. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".DayCueApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.DayCue"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ringing alarm screen (full-screen intent target). Placeholder UI; direct-boot aware. -->
        <activity
            android:name=".delivery.AlarmActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity="app.daycue.alarm"
            android:turnScreenOn="true" />

        <!-- Engine wake (single next-wake alarm). -->
        <receiver
            android:name=".scheduling.WakeAlarmReceiver"
            android:exported="false" />

        <!-- Notification buttons + delete intent. Never an ack on dismissal. -->
        <receiver
            android:name=".actions.CueActionReceiver"
            android:exported="false" />

        <!-- System broadcasts that invalidate the armed wake or the time base. -->
        <receiver
            android:name=".system.SystemEventsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Before first unlock: arms the device-protected boot snapshot only. -->
        <receiver
            android:name=".system.LockedBootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".system.LockedAlarmReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <service
            android:name=".delivery.AlarmRingingService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".delivery.RoutinePlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The only screen that can approve a remote change or a new connection. NOT exported (security review
             L-13): reached from notifications through explicit, immutable PendingIntents and from in-app UI. Intent
             extras only choose what to show; they can never approve. -->
        <activity
            android:name=".integrations.relay.RemoteConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DayCue" />

        <!-- Relay: inexact "frequent check" tick and the notification "Decline" button. -->
        <receiver
            android:name=".integrations.relay.FrequentCheckReceiver"
            android:exported="false" />
        <receiver
            android:name=".integrations.relay.RemoteActionReceiver"
            android:exported="false" />

        <!-- Places: geofence + activity-transition PendingIntent targets (Play services), and the
             re-registration triggers (boot, app update, location switch). -->
        <receiver
            android:name=".integrations.location.GeofenceBroadcastReceiver"
            android:exported="false" />
        <receiver
            android:name=".integrations.location.MotionTransitionReceiver"
            android:exported="false" />
        <receiver
            android:name=".integrations.location.LocationSystemReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.location.PROVIDERS_CHANGED" />
                <action android:name="android.location.MODE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Debug-only engine driver: disabled here, enabled at runtime only in debuggable builds,
             and only callable by holders of DUMP (adb shell). See devtools/DevToolsReceiver.kt. -->
        <receiver
            android:name=".devtools.DevToolsReceiver"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="app.daycue.devtools.CMD" />
            </intent-filter>
        </receiver>

        <!-- Persists the per-app language chosen in-app on API 26-32 (API 33+ uses the system setting). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
