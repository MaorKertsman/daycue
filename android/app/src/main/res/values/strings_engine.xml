<?xml version="1.0" encoding="utf-8"?>
<!--
  Engine/notification texts. Names are the domain text keys with "dc_" prefix and "." -> "_"
  (app.daycue.delivery.Templates.resourceName). Placeholders are {name}-style and filled by
  TextResolver; user text (names, phrases, titles) arrives as arguments.
  "_alt" = used when a referenced argument is blank. "_<kind>" = variant chosen by a "kind" argument.
  Owner: scheduling engineer. Keep values-iw/strings_engine.xml in sync.
-->
<resources>
    <!-- Habit cues (title = item name, body = phrase) -->
    <string name="dc_cue_sunscreen_title">{name}</string>
    <string name="dc_cue_sunscreen_title_alt">Sunscreen</string>
    <string name="dc_cue_hydration_title">{name}</string>
