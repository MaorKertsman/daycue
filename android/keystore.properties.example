# Copy to android/keystore.properties (git-ignored) to sign release builds.
# Paths are relative to android/. Never commit the real file or the keystore.
# Alternatively set DAYCUE_KEYSTORE_FILE, DAYCUE_KEYSTORE_PASSWORD, DAYCUE_KEY_ALIAS, DAYCUE_KEY_PASSWORD.
storeFile=../../path-outside-repo/daycue-release.jks
storePassword=CHANGE_ME
keyAlias=daycue
keyPassword=CHANGE_ME
